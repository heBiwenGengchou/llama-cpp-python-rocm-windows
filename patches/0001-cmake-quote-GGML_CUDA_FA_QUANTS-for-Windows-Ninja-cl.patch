From d5b9f0b3320bd551b25a31a201d4364b97d703c9 Mon Sep 17 00:00:00 2001
From: local build <build@local>
Date: Fri, 13 Nov 2026 16:55:09 +0800
Subject: [PATCH 1/3] cmake: quote GGML_CUDA_FA_QUANTS for Windows Ninja +
 clang/hipcc

The plain form add_compile_definitions loses its quotes when the command line passes through Ninja -> cmd -> hipcc.exe -> clang, so the macro expands to a bare token list instead of a C++ string literal.
---
 ggml/cmake/common.cmake | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/ggml/cmake/common.cmake b/ggml/cmake/common.cmake
index c8d2322..9756f4e 100644
--- a/ggml/cmake/common.cmake
+++ b/ggml/cmake/common.cmake
@@ -100,7 +100,12 @@ function(ggml_cuda_fattn_vec_instances DIR OUT_SRCS)
     list(REMOVE_DUPLICATES FA_COMBINATIONS)
 
     string(REPLACE ";" "," FA_QUANTS_DEFINE "${FA_QUANTS}")
-    add_compile_definitions(GGML_CUDA_FA_QUANTS="${FA_QUANTS_DEFINE}")
+    # NOTE (local patch, Windows + Ninja + clang/hipcc):
+    # the plain form add_compile_definitions(GGML_CUDA_FA_QUANTS="${FA_QUANTS_DEFINE}")
+    # loses its quotes: Ninja -> cmd -> hipcc.exe -> clang strips them, so the macro
+    # expands to a bare token list and fails to compile as a C++ string literal.
+    # The extra backslashes survive all three parsers.
+    add_compile_definitions(GGML_CUDA_FA_QUANTS=\\\"${FA_QUANTS_DEFINE}\\\")
     foreach (TYPE_V IN LISTS FA_TYPES)
         foreach (TYPE_K IN LISTS FA_TYPES)
             if ("${TYPE_K}-${TYPE_V}" IN_LIST FA_COMBINATIONS)
